local function sanitizeSlotName(raw)
    raw = tostring(raw or ""):gsub("^%s+", ""):gsub("%s+$", "")
    raw = raw:gsub("[^%w%-_]", "")
    if raw == "" then return nil end
    if #raw > 24 then raw = raw:sub(1, 24) end
    if raw:match("^assignments_") then return nil end
    if raw:match("^pid_") then return nil end -- would collide with pid_<slot>.lua
    if raw:match("^wp_") then return nil end -- would collide with wp_<slot>.lua
    return raw
end

local function listConfigNames()
    local names = {}
    if not fs.exists(configDir) then
        fs.makeDir(configDir)
    end
    for _, file in ipairs(fs.list(configDir)) do
        if file:match("%.lua$") and not file:match("^assignments_") and not file:match("^pid_") then
            table.insert(names, (file:gsub("%.lua$", "")))
        end
    end
    table.sort(names, function(a, b) return a:lower() < b:lower() end)
    return names
end

local function buildSlots()
    local names = listConfigNames()
    local slots = {}
    -- never truncate existing configs (MAX_SLOTS is only a minimum menu size)
    local n = math.max(#names, MAX_SLOTS)
    for i = 1, n do
        slots[i] = names[i] or false -- false = empty
    end
    return slots
end

local function templateSourceName(slots)
    for _, s in ipairs(slots) do
        if s then return s end
    end
    if fs.exists(configDir .. "/atlas.lua") then return "atlas" end
    return nil
end

local function writeNewConfig(slotName, templateName)
    local data
    if templateName and fs.exists(configDir .. "/" .. templateName .. ".lua") then
        local h = fs.open(configDir .. "/" .. templateName .. ".lua", "r")
        data = h.readAll()
        h.close()
        data = data:gsub('name%s*=%s*"[^"]*"', 'name = "' .. slotName .. '"', 1)
    else
        data = FALLBACK_TEMPLATE:gsub('name%s*=%s*"[^"]*"', 'name = "' .. slotName .. '"', 1)
    end
    local out = fs.open(configDir .. "/" .. slotName .. ".lua", "w")
    if not out then return false end
    out.write(data)
    out.close()
    return true
end

local function deleteConfig(slotName)
    local ok = pcall(function()
        if fs.exists(configDir .. "/" .. slotName .. ".lua") then
            fs.delete(configDir .. "/" .. slotName .. ".lua")
        end
        local afile = configDir .. "/assignments_" .. slotName .. ".lua"
        if fs.exists(afile) then
            fs.delete(afile)
        end
        local pfile = configDir .. "/pid_" .. slotName .. ".lua"
        if fs.exists(pfile) then
            fs.delete(pfile)
        end
    end)
    return ok
end

local function drawConfigMenu(slots, cursor, confirmIdx, message)
    term.clear()
    term.setCursorPos(1, 1)

    if term.isColor() then term.setTextColor(colors.blue) end
    print("========================================")
    print("        ARTCORPOS SAVE SLOTS")
    print("   Select a ship config to load")
    print("========================================")
    if term.isColor() then term.setTextColor(colors.white) end
    print("")

    for i, slot in ipairs(slots) do
        local y = select(2, term.getCursorPos())
        local prefix = (i == cursor) and "> " or "  "
        local label
        if slot then
            label = string.format("%d) %s", i, slot)
        else
            label = string.format("%d) [ empty slot ]", i)
        end

        local is_confirm = (confirmIdx == i)
        if i == cursor and not is_confirm and term.isColor() then
            term.setTextColor(colors.yellow)
        end
        if is_confirm and term.isColor() then
            term.setTextColor(colors.red)
        end
        write(prefix .. label)
        if is_confirm then
            write("   DELETE? D=yes  SPACE=no")
        end
        if term.isColor() then term.setTextColor(colors.white) end
        print("")
    end

    print("")
    if message then
        if term.isColor() then term.setTextColor(colors.lime) end
        print(message)
        if term.isColor() then term.setTextColor(colors.white) end
    end
    print("W/S move   SPACE select/save   D delete")
    print("In confirm: D=confirm  SPACE=cancel")
end

local function configSlotMenu()
    local slots = buildSlots()
    local cursor = 1
    local confirmIdx = nil
    local message = nil

    -- If exactly one config exists, still show menu (user asked for game-like flow)
    while true do
        drawConfigMenu(slots, cursor, confirmIdx, message)
        message = nil

        local event, key, held = os.pullEvent("key")
        if event == "key" and not held then
            if key == keysLib.up or key == keysLib.w then
                confirmIdx = nil
                cursor = cursor - 1
                if cursor < 1 then cursor = #slots end

            elseif key == keysLib.down or key == keysLib.s then
                confirmIdx = nil
                cursor = cursor + 1
                if cursor > #slots then cursor = 1 end

            elseif key == keysLib.space then
                if confirmIdx then
                    confirmIdx = nil
                    message = "Delete cancelled"
                else
                    local slot = slots[cursor]
                    if slot then
                        return slot
                    end
                    term.clear()
                    term.setCursorPos(1, 1)
                    print("New save in slot " .. cursor)
                    print("Enter ship name (letters/numbers/_/-):")
                    write("> ")
                    local raw = read()
                    local name = sanitizeSlotName(raw)
                    if not name then
                        message = "Invalid name"
                    else
                        local taken = false
                        for _, s in ipairs(slots) do
                            if s == name then taken = true break end
                        end
                        if taken or fs.exists(configDir .. "/" .. name .. ".lua") then
                            message = "Name already used"
                        else
                            local tmpl = templateSourceName(slots)
                            if writeNewConfig(name, tmpl) then
                                slots = buildSlots()
                                for i, s in ipairs(slots) do
                                    if s == name then cursor = i break end
                                end
                                message = "Created '" .. name .. "' — SPACE to load"
                            else
                                message = "Failed to write config"
                            end
                        end
                    end
                end

            elseif key == keysLib.d then
                local slot = slots[cursor]
                if not slot then
                    message = "Empty slot — nothing to delete"
                elseif confirmIdx == cursor then
                    if deleteConfig(slot) then
                        message = "Deleted '" .. slot .. "'"
                    else
                        message = "Delete failed"
                    end
                    confirmIdx = nil
                    slots = buildSlots()
                    if not slots[cursor] then
                        for i, s in ipairs(slots) do
                            if s then cursor = i break end
                        end
                        if not slots[cursor] then cursor = 1 end
                    end
                else
                    confirmIdx = cursor
                    message = "Press D again to delete '" .. slot .. "'"
                end

            elseif key == keysLib.enter or key == keysLib.numPadEnter then
                local slot = slots[cursor]
                if slot and not confirmIdx then
                    return slot
                end
            end
        end
    end
end

