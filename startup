    output_REAR = "Rear thruster relay",
    main_monitor = "HUD display monitor",
    printer = "Network printer (flight reports)",
    speaker = "Audio speaker",
}

local function peripheralOrder()
    return {
        input_1 = 1, input_2 = 2,
        aux_relay = 3,
        engine_relay = 4,
        output_FL = 5, output_FR = 6, output_RL = 7, output_RR = 8,
        output_REAR = 9,
        main_monitor = 10, speaker = 11, printer = 12,
    }
end

local function buildRequired()
    local required = {}
    local order = peripheralOrder()
    for key, name in pairs(config.peripherals) do
        if name and name ~= "" then
            table.insert(required, {
                key = key,
                target = name,
                desc = peripheral_desc[key] or key,
            })
        end
    end
    table.sort(required, function(a, b)
        return (order[a.key] or 99) < (order[b.key] or 99)
    end)
    return required
end

local function writeAssignments(path, data)
    local save_fn = io.open(path, "w")
    if not save_fn then return false end
    save_fn:write("return {\n")
    if data.config_version then
        save_fn:write("  config_version = " .. string.format("%q", data.config_version) .. ",\n")
    end
    if data.ship_id then
        save_fn:write("  ship_id = " .. string.format("%q", data.ship_id) .. ",\n")
    end
    for key, name in pairs(data) do
        if key ~= "config_version" and key ~= "ship_id" then
            save_fn:write("  [" .. string.format("%q", key) .. "] = " .. string.format("%q", name) .. ",\n")
        end
    end
    save_fn:write("}\n")
    save_fn:close()
    return true
end

local function assignmentsCompatible(asaved)
    if type(asaved) ~= "table" then return false, "not a table" end
    if asaved.config_version ~= config.version then
        return false, "config v" .. tostring(asaved.config_version) .. " -> v" .. tostring(config.version)
    end
    for key, name in pairs(config.peripherals) do
        if name and name ~= "" and not asaved[key] then
            return false, "missing " .. key
        end
    end
    return true, "ok"
end

-- Check for saved assignments
local assignments_file = configDir .. "/assignments_" .. selected_config .. ".lua"
local assignments = {}
local has_saved = false
local stale_reason = nil
if fs.exists(assignments_file) then
    local aok, asaved = pcall(function()
        local fn = loadfile(assignments_file)
        if fn then return fn() end
    end)
    if aok and type(asaved) == "table" then
        local ok, why = assignmentsCompatible(asaved)
        if ok then
            assignments = asaved
            has_saved = true
        else
            stale_reason = why
            print("[3/5] Saved assignments OUTDATED (" .. tostring(why) .. ")")
            print("  Full peripheral re-wizard required.")
            print("")
        end
    end
end

if has_saved then
    print("[3/5] Using saved peripheral assignments (config v" .. tostring(config.version) .. ")")
    for key, name in pairs(assignments) do
        if key ~= "config_version" and key ~= "ship_id" then
            print("  " .. key .. " -> " .. name)
        end
    end
    print("")
else
    if stale_reason then
        print("  Disconnect ALL modems again for a clean re-scan.")
        promptContinue("  When all modems are removed, press any key.")
    end
    print("[3/5] Peripheral setup wizard")
    print("  Ship: " .. tostring(ship.name or ship.id) .. "  config v" .. tostring(config.version))
    print("  Connect one device at a time when prompted.")
    print("")

    assignments = {}
    assignments.config_version = config.version
    assignments.ship_id = ship.id

    local required = buildRequired()

    print("  Scanning current network...")
    local baseline = scanNetwork()
    print("  Found " .. #baseline .. " device(s) already connected.")
    print("")

    for i, req in ipairs(required) do
        write("  [" .. i .. "/" .. #required .. "] Connect: ")
        blue(req.desc)
        write("  (")
        blue(req.target)
        print(")")
        promptContinue("  Plug in this device's modem, then right-click it.")

        local new_dev = waitForNewDevice(baseline)
        assignments[req.key] = new_dev.name
        write("  -> ")
        blue(req.key)
        print(" = " .. new_dev.name)
        print("")

        table.insert(baseline, new_dev)
    end

    if writeAssignments(assignments_file, assignments) then
        print("  Assignments saved to " .. assignments_file)
    end
end

-- Apply assignments to config (skip bookkeeping keys; kbd_computer is a
-- rednet id, NOT a peripheral - never put it in config.peripherals)
for key, name in pairs(assignments) do
    if key ~= "config_version" and key ~= "ship_id" and key ~= "kbd_computer" then
        config.peripherals[key] = name
    end
end

-- Assign optional peripherals that are still missing after a compatible save
local function saveAssignments()
    return writeAssignments(assignments_file, assignments)
end

local optional = config.optional_peripherals or {}
if #optional > 0 then
    local baseline = scanNetwork()
    local any_new = false
    for _, key in ipairs(optional) do
        local current = assignments[key]
        local wrapped = current and peripheral.wrap(current)
        if not wrapped then
            any_new = true
            write("[3b] Optional: ")
            blue(key)
            print("  (" .. (peripheral_desc[key] or key) .. ")")
            promptContinue("  Plug in this device's modem, then right-click it.")
            local new_dev = waitForNewDevice(baseline)
            assignments[key] = new_dev.name
            config.peripherals[key] = new_dev.name
            table.insert(baseline, new_dev)
            print("  -> " .. key .. " = " .. new_dev.name)
            print("")
        end
    end
    if any_new then
        assignments.config_version = config.version
        assignments.ship_id = ship.id
        if saveAssignments() then
            print("  Assignments updated: " .. assignments_file)
            print("")
        end
    end
end

