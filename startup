    if kbd_id then
        blue("#" .. kbd_id)
        print("  (pairs automatically when online)")
    else
        blue("not paired yet")
        print("")
        if term.isColor() then term.setTextColor(colors.blue) end
        print("  Run 'kbd' on a computer wired to this network.")
        if term.isColor() then term.setTextColor(colors.white) end
        print("  Press any key to continue" ..
            (wait_secs and (", auto-continue in " .. wait_secs .. "s")
                or " (pairs automatically later)") .. "...")
    end
end

local function waitKbdPair(timeout)
    for _, mname in ipairs(peripheral.getNames()) do
        local mtype = peripheral.getType(mname) or ""
        if mtype:find("modem") then pcall(rednet.open, mname) end
    end
    local t_id = timeout and os.startTimer(timeout)
    while not kbd_id do
        local ev, a, b = os.pullEvent()
        if ev == "rednet_message" and type(b) == "table"
            and b.proto == "artkbd" and b.op == "hello" then
            kbd_id = tonumber(a)
        elseif ev == "key" then
            break
        elseif ev == "timer" and a == t_id then
            print("  No keyboard heard - continuing (it can pair later).")
            break
        end
    end
    if t_id then os.cancelTimer(t_id) end
end

if kbd_id then
    showKbdInfo(nil)
elseif has_saved then
    showKbdInfo(30)
    waitKbdPair(30)
else
    print("[3d] Network keyboard computer (kbd): optional")
    if term.isColor() then term.setTextColor(colors.blue) end
    print("  Run 'kbd' on a second computer wired to this network.")
    if term.isColor() then term.setTextColor(colors.white) end
    print("  Press any key to continue without it (pairs later)...")
    waitKbdPair(nil)
end
if kbd_id then
    assignments.kbd_computer = tostring(kbd_id)
    saveAssignments()
    config.kbd_id = kbd_id
    write("  -> Paired: keyboard computer ")
    blue("#" .. kbd_id)
    print("")
end
