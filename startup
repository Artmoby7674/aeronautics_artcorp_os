-- Ensure lib/*.lua and root modules resolve for the whole startup script
local function ensurePackagePath()
    local paths = {
        "?.lua",
        "./?.lua",
        "/?.lua",
        "lib/?.lua",
        "./lib/?.lua",
        "/lib/?.lua",
    }
    for _, p in ipairs(paths) do
        if not tostring(package.path or ""):find(p, 1, true) then
            package.path = p .. ";" .. tostring(package.path or "")
        end
    end
end
ensurePackagePath()

